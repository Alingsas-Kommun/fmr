{
  "name": "fmr",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . ./resources/lang/fmr.pot --include=\"patterns,app,resources,routes\"",
    "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/fmr.pot $file; done",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print --no-purge && node scripts/js-translation-fix.js",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
  },
  "devDependencies": {
    "@roots/vite-plugin": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "laravel-vite-plugin": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "sass": "^1.85.1"
  },
  "dependencies": {
    "alpinejs": "^3.14.9"
  }
}
